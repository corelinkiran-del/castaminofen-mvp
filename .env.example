# Environment Configuration Template

# ============================================
# Environment
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# Core Services - Ports
# ============================================
PORT=8000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CONTENT_SERVICE_PORT=3003
MEDIA_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://media_user:media_password@postgres:5432/media_platform
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=50
DATABASE_POOL_TIMEOUT=30

# ============================================
# Cache (Redis)
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Search (Elasticsearch)
# ============================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================
# Object Storage (MinIO)
# ============================================
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media-platform
MINIO_REGION=us-east-1

# ============================================
# Message Queue (RabbitMQ)
# ============================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_VHOST=/

# ============================================
# JWT & Authentication
# ============================================
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=2592000
JWT_ALGORITHM=HS256

# ============================================
# OAuth2 Providers
# ============================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/oauth/google/callback

APPLE_CLIENT_ID=com.mediaplatform.web
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ============================================
# Email Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Media Platform
SMTP_FROM_EMAIL=noreply@media-platform.ir

# ============================================
# Payment Gateway (Iranian)
# ============================================
PAYMENT_GATEWAY_NAME=zarrinpal
PAYMENT_GATEWAY_API_KEY=your-api-key
PAYMENT_GATEWAY_SECRET=your-secret
PAYMENT_GATEWAY_CALLBACK_URL=https://api.media-platform.ir/api/payments/verify

# ============================================
# CDN Configuration
# ============================================
CDN_URL=https://media-cdn.ir
CDN_PROVIDER=cloudflare
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-api-token

# ============================================
# Frontend URLs
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
MOBILE_API_URL=http://localhost:8000/v1

# ============================================
# Service Discovery & Mesh (Optional)
# ============================================
CONSUL_HOST=consul
CONSUL_PORT=8500
SERVICE_NAME=media-platform
SERVICE_VERSION=1.0.0

# ============================================
# Monitoring & Logging
# ============================================
SENTRY_DSN=https://your-sentry-dsn
DATADOG_API_KEY=your-datadog-key
PROMETHEUS_PORT=9090

# ============================================
# Feature Flags
# ============================================
FEATURE_OAUTH=true
FEATURE_ANALYTICS=true
FEATURE_RECOMMENDATIONS=false
FEATURE_ASR=false

# ============================================
# Debug & Development
# ============================================
DEBUG=*
MOCK_PAYMENTS=false
SKIP_VERIFICATION_EMAIL=false
ALLOW_CORS_ALL=false
